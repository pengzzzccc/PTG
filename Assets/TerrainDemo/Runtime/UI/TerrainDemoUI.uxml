<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="demo-panel" class="demo-panel">
        <ui:VisualElement name="seed-module" class="module seed-module">
            <ui:IntegerField label="Seed" name="seed-field" class="seed-field" />
            <ui:Button text="Random Seed" name="random-button" class="seed-button" />
        </ui:VisualElement>

        <ui:VisualElement name="param-module" class="module param-module">
            <ui:VisualElement name="preset-row" class="preset-row">
                <ui:Button text="Rolling Hills" name="preset-hills" class="preset-button" />
                <ui:Button text="Rugged Peaks" name="preset-peaks" class="preset-button" />
                <ui:Button text="Terraced Mesas" name="preset-mesas" class="preset-button" />
            </ui:VisualElement>

            <ui:ScrollView name="panel-scroll" class="panel-scroll">
                <ui:SliderInt label="Resolution" name="resolution-slider" low-value="33" high-value="513" show-input-field="true" />
                <ui:Slider label="Height Scale (m)" name="height-scale-slider" low-value="5" high-value="100" show-input-field="true" />
                <ui:Slider label="Wavelength (m)" name="scale-slider" low-value="20" high-value="300" show-input-field="true" />
                <ui:SliderInt label="Octaves" name="octaves-slider" low-value="1" high-value="12" show-input-field="true" />
                <ui:Slider label="Lacunarity" name="lacunarity-slider" low-value="1.2" high-value="4" show-input-field="true" />
                <ui:Slider label="Persistence" name="persistence-slider" low-value="0.05" high-value="0.95" show-input-field="true" />
                <ui:Slider label="Feedback Offset" name="offset-slider" low-value="0" high-value="1.5" show-input-field="true" />
                <ui:Slider label="Feedback Gain" name="gain-slider" low-value="0.5" high-value="4" show-input-field="true" />
                <ui:Slider label="Height Exponent" name="exponent-slider" low-value="0.5" high-value="4" show-input-field="true" />
                <ui:SliderInt label="Terrace Levels" name="terrace-slider" low-value="0" high-value="64" show-input-field="true" />
            </ui:ScrollView>

            <ui:VisualElement name="footer-row" class="footer-row">
                <ui:Button text="View: Shaded" name="view-mode-button" class="view-button" />
                <ui:Button text="Generate" name="generate-button" class="generate-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="color-panel" class="demo-panel color-panel">
        <ui:VisualElement name="color-count-module" class="module color-count-module">
            <ui:SliderInt label="Colors" name="color-count-slider" low-value="1" high-value="8" show-input-field="true" />
        </ui:VisualElement>

        <ui:VisualElement name="color-module" class="module color-module">
            <ui:ScrollView name="color-list" class="panel-scroll color-list" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:Label text="No terrain generated yet" name="stats-label" class="stats" picking-mode="Ignore" />
    <ui:Label name="tooltip-label" class="tooltip" picking-mode="Ignore" />
</ui:UXML>
